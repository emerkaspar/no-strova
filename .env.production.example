# Copie para .env.production e preencha com os valores do projeto Firebase de PRODUÇÃO.
# Apenas configuração pública do cliente (VITE_*). Nunca coloque segredos aqui.
VITE_FIREBASE_API_KEY=TROCAR
VITE_FIREBASE_AUTH_DOMAIN=TROCAR-no-strova-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=TROCAR-no-strova-prod
VITE_FIREBASE_STORAGE_BUCKET=TROCAR-no-strova-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=TROCAR
VITE_FIREBASE_APP_ID=TROCAR

# Push no celular: chave pública (par de chaves Web Push) em Configurações do projeto > Cloud Messaging > Certificados push da Web.
VITE_FIREBASE_VAPID_KEY=TROCAR

# Opcional: token PUBLICO do Mapbox (mapa do detalhe da atividade). Sem ele, usa o OpenStreetMap.
VITE_MAPBOX_TOKEN=

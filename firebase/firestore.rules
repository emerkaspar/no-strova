rules_version = '2';

// Regras por papel e por dono do registro (sem multi-tenancy).
// Princípios:
//  - Acesso aos dados de negócio exige usuário aprovado E ativo.
//  - Peso, FC e demais dados de saúde: somente o dono lê/escreve (nem o admin).
//  - Coleções com valor autoritativo (HRSS, agregações, IA, cotas) só são escritas pelo Admin SDK.
//  - Tudo que não está listado aqui é negado.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function perfilDe(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Aprovado e ativo. O documento users/{uid} só é escrito pelo Admin SDK.
    function acessoLiberado() {
      return logado()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && perfilDe(request.auth.uid).aprovado == true
        && perfilDe(request.auth.uid).ativo == true;
    }

    function ehAdmin() {
      return acessoLiberado() && perfilDe(request.auth.uid).role == 'admin';
    }

    function donoDoRegistro() {
      return resource.data.userId == request.auth.uid;
    }

    function novoRegistroDoUsuario() {
      return request.resource.data.userId == request.auth.uid;
    }

    // Perfil: o dono lê sempre (precisa ver "aguardando aprovação"); o admin lê todos.
    // O dono só edita nome, data de nascimento e avatar (foto ou personagem); papel, aprovação e ativo são do Admin SDK.
    match /users/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());

      allow update: if acessoLiberado()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'dataNascimento', 'avatar', 'avatarEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 80
        && (request.resource.data.dataNascimento == null
            || (request.resource.data.dataNascimento is string
                && request.resource.data.dataNascimento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('avatar' in request.resource.data)
            || request.resource.data.avatar == null
            || (request.resource.data.avatar is string
                && request.resource.data.avatar.matches('^(foto|personagem:[a-z-]{2,30})$')))
        && (!('avatarEm' in request.resource.data) || request.resource.data.avatarEm is int);

      allow create, delete: if false;
    }

    // Dados do próprio usuário, escritos pelo cliente. A validação de campos de cada
    // coleção entra junto com a funcionalidade (Fases 2, 4 e 5).
    // Configuração do atleta com vigência: o cliente escreve, mas só valores plausíveis.
    // As Functions revalidam ao ler (validarConfigAtleta) e ignoram o que for inválido.
    function configValida() {
      let c = request.resource.data;
      return c.keys().hasOnly(['userId', 'vigenteDesde', 'fcMax', 'fcRepouso', 'lthr', 'sexo', 'pesoKg', 'alturaCm'])
        && c.keys().hasAll(['userId', 'vigenteDesde', 'fcMax', 'fcRepouso', 'lthr', 'sexo', 'pesoKg', 'alturaCm'])
        && c.userId == request.auth.uid
        && c.vigenteDesde is string
        && c.vigenteDesde.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && c.fcMax is int && c.fcMax >= 100 && c.fcMax <= 250
        && c.fcRepouso is int && c.fcRepouso >= 25 && c.fcRepouso <= 120
        && c.fcRepouso < c.fcMax
        && c.lthr is int && c.lthr > c.fcRepouso && c.lthr <= c.fcMax
        && c.sexo in ['masculino', 'feminino']
        && c.pesoKg is number && c.pesoKg >= 20 && c.pesoKg <= 400
        && c.alturaCm is number && c.alturaCm >= 100 && c.alturaCm <= 250;
    }

    match /configsAtleta/{id} {
      allow read, delete: if acessoLiberado() && donoDoRegistro();
      allow create: if acessoLiberado() && configValida();
      allow update: if acessoLiberado() && donoDoRegistro() && configValida();
    }

    // Plano de treino: o cliente escreve (nenhuma decisão do servidor depende destes campos), mas só valores plausíveis.
    function treinoValido() {
      let t = request.resource.data;
      return t.keys().hasOnly(['userId', 'data', 'esporte', 'duracaoMin', 'zona', 'estresseEstimado', 'estresseManual', 'observacoes', 'status', 'atividadeId', 'criadoEm', 'passos', 'nomeTreino', 'modeloId', 'geradoPorIa'])
        && t.keys().hasAll(['userId', 'data', 'esporte', 'duracaoMin', 'zona', 'status'])
        && t.userId == request.auth.uid
        && t.data is string
        && t.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && t.esporte in ['ciclismo', 'corrida', 'outro']
        && t.duracaoMin is int && t.duracaoMin >= 5 && t.duracaoMin <= 1440
        && t.zona in ['Z1', 'Z2', 'Z3', 'Z4', 'Z5']
        && t.status in ['planejado', 'realizado', 'pulado']
        && (!('estresseEstimado' in t) || t.estresseEstimado == null || (t.estresseEstimado is number && t.estresseEstimado >= 0 && t.estresseEstimado <= 2000))
        && (!('estresseManual' in t) || t.estresseManual == null || (t.estresseManual is number && t.estresseManual > 0 && t.estresseManual <= 2000))
        && (!('observacoes' in t) || (t.observacoes is string && t.observacoes.size() <= 500))
        && (!('atividadeId' in t) || t.atividadeId == null || (t.atividadeId is string && t.atividadeId.size() <= 40))
        && (!('criadoEm' in t) || t.criadoEm is timestamp)
        // treino estruturado (intervalado): os blocos, o nome e o modelo de origem. O cliente valida os passos
        // (validarPassos); aqui o limite é o tamanho.
        && (!('passos' in t) || (t.passos is list && t.passos.size() >= 1 && t.passos.size() <= 30))
        && (!('nomeTreino' in t) || (t.nomeTreino is string && t.nomeTreino.size() >= 1 && t.nomeTreino.size() <= 60))
        && (!('modeloId' in t) || t.modeloId == null || (t.modeloId is string && t.modeloId.size() <= 80))
        // marca dos treinos que a rotina de domingo (IA) cria; só o servidor a grava, e o cliente a preserva ao editar
        && (!('geradoPorIa' in t) || t.geradoPorIa is bool);
    }

    match /treinosPlanejados/{id} {
      allow read, delete: if acessoLiberado() && donoDoRegistro();
      allow create: if acessoLiberado() && treinoValido();
      allow update: if acessoLiberado() && donoDoRegistro() && treinoValido();
    }

    // Treinos intervalados próprios do usuário (modelos). O catálogo do sistema fica no código. As Functions não leem
    // estes documentos; o cliente valida os passos (validarTreinoEstruturado) e ignora os inválidos ao ler.
    function modeloTreinoValido() {
      let m = request.resource.data;
      return m.keys().hasOnly(['userId', 'nome', 'esporte', 'foco', 'nivel', 'descricao', 'passos', 'trajetoId', 'trajetoNome', 'criadoEm'])
        && m.keys().hasAll(['userId', 'nome', 'esporte', 'foco', 'nivel', 'passos'])
        && (!('trajetoId' in m) || (m.trajetoId is string && m.trajetoId.size() >= 1 && m.trajetoId.size() <= 128 && m.trajetoNome is string && m.trajetoNome.size() >= 1 && m.trajetoNome.size() <= 60))
        && m.userId == request.auth.uid
        && m.nome is string && m.nome.size() >= 3 && m.nome.size() <= 60
        && m.esporte in ['ciclismo', 'corrida']
        && m.foco in ['vo2max', 'limiar', 'tempo', 'overunder', 'piramide', 'fartlek', 'sprint', 'progressivo', 'subidas', 'recuperacao', 'resistencia', 'teste', 'recorde']
        && m.nivel in ['iniciante', 'intermediario', 'avancado']
        && (!('descricao' in m) || (m.descricao is string && m.descricao.size() <= 500))
        && m.passos is list && m.passos.size() >= 1 && m.passos.size() <= 30
        && (!('criadoEm' in m) || m.criadoEm is timestamp);
    }

    match /treinosModelos/{id} {
      allow read, delete: if acessoLiberado() && donoDoRegistro();
      allow create: if acessoLiberado() && modeloTreinoValido();
      allow update: if acessoLiberado() && donoDoRegistro() && modeloTreinoValido();
    }

    // Meta de forma: "chegar com Forma X na data Y". Uma ativa por vez (o cliente desativa a anterior).
    function metaValida() {
      let m = request.resource.data;
      return m.keys().hasOnly(['userId', 'formaAlvo', 'dataAlvo', 'ativa', 'criadoEm'])
        && m.keys().hasAll(['userId', 'formaAlvo', 'dataAlvo', 'ativa'])
        && m.userId == request.auth.uid
        && m.formaAlvo is number && m.formaAlvo >= -60 && m.formaAlvo <= 60
        && m.dataAlvo is string
        && m.dataAlvo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && m.ativa is bool
        && (!('criadoEm' in m) || m.criadoEm is timestamp);
    }

    match /metasForma/{id} {
      allow read, delete: if acessoLiberado() && donoDoRegistro();
      allow create: if acessoLiberado() && metaValida();
      allow update: if acessoLiberado() && donoDoRegistro() && metaValida();
    }

    // Meta de Condicionamento (a meta principal do plano): "chegar com Condicionamento X na data Y". Uma ativa por vez.
    // `condicionamentoInicial` é o Condicionamento de quando a meta foi criada (base do progresso).
    function metaCondicionamentoValida() {
      let m = request.resource.data;
      return m.keys().hasOnly(['userId', 'condicionamentoAlvo', 'condicionamentoInicial', 'dataAlvo', 'ativa', 'criadoEm'])
        && m.keys().hasAll(['userId', 'condicionamentoAlvo', 'dataAlvo', 'ativa'])
        && m.userId == request.auth.uid
        && m.condicionamentoAlvo is number && m.condicionamentoAlvo >= 1 && m.condicionamentoAlvo <= 250
        && (!('condicionamentoInicial' in m) || m.condicionamentoInicial == null
            || (m.condicionamentoInicial is number && m.condicionamentoInicial >= 0 && m.condicionamentoInicial <= 250))
        && m.dataAlvo is string
        && m.dataAlvo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && m.ativa is bool
        && (!('criadoEm' in m) || m.criadoEm is timestamp);
    }

    match /metasCondicionamento/{id} {
      allow read, delete: if acessoLiberado() && donoDoRegistro();
      allow create: if acessoLiberado() && metaCondicionamentoValida();
      allow update: if acessoLiberado() && donoDoRegistro() && metaCondicionamentoValida();
    }

    // Prova (evento-alvo) com prioridade A/B/C: guia o plano anual. Nenhuma decisão do servidor depende destes campos.
    // Os opcionais (distância, meta de tempo, local e Forma-alvo) podem ser nulos.
    function provaValida() {
      let p = request.resource.data;
      return p.keys().hasOnly(['userId', 'nome', 'data', 'esporte', 'prioridade', 'distanciaKm', 'metaTempoS', 'local', 'formaAlvo', 'criadoEm'])
        && p.keys().hasAll(['userId', 'nome', 'data', 'esporte', 'prioridade'])
        && p.userId == request.auth.uid
        && p.nome is string && p.nome.size() >= 3 && p.nome.size() <= 60
        && p.data is string
        && p.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && p.esporte in ['ciclismo', 'corrida', 'outro']
        && p.prioridade in ['A', 'B', 'C']
        && (!('distanciaKm' in p) || p.distanciaKm == null || (p.distanciaKm is number && p.distanciaKm >= 0.1 && p.distanciaKm <= 1000))
        && (!('metaTempoS' in p) || p.metaTempoS == null || (p.metaTempoS is number && p.metaTempoS >= 60 && p.metaTempoS <= 172800))
        && (!('local' in p) || p.local == null || (p.local is string && p.local.size() <= 80))
        && (!('formaAlvo' in p) || p.formaAlvo == null || (p.formaAlvo is number && p.formaAlvo >= -60 && p.formaAlvo <= 60))
        && (!('criadoEm' in p) || p.criadoEm is timestamp);
    }

    match /provas/{id} {
      allow read, delete: if acessoLiberado() && donoDoRegistro();
      allow create: if acessoLiberado() && provaValida();
      allow update: if acessoLiberado() && donoDoRegistro() && provaValida();
    }

    // Pesagem: uma por dia (o app grava com id uid_yyyymmdd, então regravar substitui). Peso de 20 a 400 kg.
    function pesagemValida() {
      let p = request.resource.data;
      return p.keys().hasOnly(['userId', 'data', 'pesoKg', 'criadoEm'])
        && p.keys().hasAll(['userId', 'data', 'pesoKg'])
        && p.userId == request.auth.uid
        && p.data is string
        && p.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && p.pesoKg is number && p.pesoKg >= 20 && p.pesoKg <= 400
        && (!('criadoEm' in p) || p.criadoEm is timestamp);
    }

    match /pesagens/{id} {
      allow read, delete: if acessoLiberado() && donoDoRegistro();
      allow create: if acessoLiberado() && pesagemValida();
      allow update: if acessoLiberado() && donoDoRegistro() && pesagemValida();
    }

    // Preferências de notificação (dentro de preferencias/{uid}): tipos ligados/desligados e intervalos dos lembretes.
    // Os tipos e os limites espelham TIPOS_NOTIFICACAO e LIMITES_INTERVALO em packages/domain/src/notificacoes.js.
    function tipoNotifOk(t, campo) {
      return !(campo in t) || t[campo] is bool;
    }

    function intervaloNotifOk(n, campo, min, max) {
      return !(campo in n) || (n[campo] is int && n[campo] >= min && n[campo] <= max);
    }

    function preferenciasNotificacaoValidas(n) {
      return n is map
        && n.keys().hasOnly(['tipos', 'tiposPush', 'intervaloPesoDias', 'intervaloMedidasDias', 'intervaloLthrSemanas'])
        && intervaloNotifOk(n, 'intervaloPesoDias', 1, 90)
        && intervaloNotifOk(n, 'intervaloMedidasDias', 7, 365)
        && intervaloNotifOk(n, 'intervaloLthrSemanas', 2, 52)
        && (!('tipos' in n) || tiposNotificacaoValidos(n.tipos))
        && (!('tiposPush' in n) || tiposNotificacaoValidos(n.tiposPush));
    }

    function tiposNotificacaoValidos(t) {
      return t is map
        && t.keys().hasOnly(['treinoHoje', 'treinoOntem', 'comoFoi', 'conflitoTreinos', 'pesar', 'medidas', 'testeLthr', 'provaChegando', 'prazoMeta', 'conquista', 'recorde', 'garminExpirando', 'envioFalhou', 'intervalsChaveInvalida', 'contaAprovada', 'aguardandoAprovacao', 'rascunhoIa', 'semanaIa'])
        && tipoNotifOk(t, 'treinoHoje')
        && tipoNotifOk(t, 'treinoOntem')
        && tipoNotifOk(t, 'comoFoi')
        && tipoNotifOk(t, 'conflitoTreinos')
        && tipoNotifOk(t, 'pesar')
        && tipoNotifOk(t, 'medidas')
        && tipoNotifOk(t, 'testeLthr')
        && tipoNotifOk(t, 'provaChegando')
        && tipoNotifOk(t, 'prazoMeta')
        && tipoNotifOk(t, 'conquista')
        && tipoNotifOk(t, 'recorde')
        && tipoNotifOk(t, 'garminExpirando')
        && tipoNotifOk(t, 'envioFalhou')
        && tipoNotifOk(t, 'intervalsChaveInvalida')
        && tipoNotifOk(t, 'contaAprovada')
        && tipoNotifOk(t, 'aguardandoAprovacao')
        && tipoNotifOk(t, 'rascunhoIa')
        && tipoNotifOk(t, 'semanaIa');
    }

    // Medidas corporais (fita métrica): um registro por dia (id uid_yyyymmdd). Cada medida é opcional, de 10 a 250 cm.
    // Dado de saúde: só o dono lê e grava (nem o admin).
    function medidaOk(m, campo) {
      return !(campo in m) || (m[campo] is number && m[campo] >= 10 && m[campo] <= 250);
    }

    function medidasValidas() {
      let m = request.resource.data;
      return m.keys().hasOnly(['userId', 'data', 'pescocoCm', 'toraxCm', 'cinturaCm', 'abdomenCm', 'quadrilCm', 'bracoCm', 'coxaCm', 'panturrilhaCm', 'criadoEm'])
        && m.keys().hasAll(['userId', 'data'])
        && m.keys().size() >= 3
        && m.userId == request.auth.uid
        && m.data is string
        && m.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && medidaOk(m, 'pescocoCm') && medidaOk(m, 'toraxCm') && medidaOk(m, 'cinturaCm') && medidaOk(m, 'abdomenCm')
        && medidaOk(m, 'quadrilCm') && medidaOk(m, 'bracoCm') && medidaOk(m, 'coxaCm') && medidaOk(m, 'panturrilhaCm')
        && (!('criadoEm' in m) || m.criadoEm is timestamp);
    }

    match /medidas/{id} {
      allow read, delete: if acessoLiberado() && donoDoRegistro();
      allow create: if acessoLiberado() && medidasValidas();
      allow update: if acessoLiberado() && donoDoRegistro() && medidasValidas();
    }

    // Meta de peso: "chegar a X kg na data Y". Uma ativa por vez (as demais ficam como "anterior").
    // pesoInicialKg é o peso de quando a meta foi criada (base do progresso).
    function metaPesoValida() {
      let m = request.resource.data;
      return m.keys().hasOnly(['userId', 'pesoAlvoKg', 'pesoInicialKg', 'dataAlvo', 'status', 'criadoEm'])
        && m.keys().hasAll(['userId', 'pesoAlvoKg', 'dataAlvo', 'status'])
        && m.userId == request.auth.uid
        && m.pesoAlvoKg is number && m.pesoAlvoKg >= 20 && m.pesoAlvoKg <= 400
        && (!('pesoInicialKg' in m) || m.pesoInicialKg == null
            || (m.pesoInicialKg is number && m.pesoInicialKg >= 20 && m.pesoInicialKg <= 400))
        && m.dataAlvo is string
        && m.dataAlvo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && m.status in ['ativa', 'anterior']
        && (!('criadoEm' in m) || m.criadoEm is timestamp);
    }

    match /metasPeso/{id} {
      allow read, delete: if acessoLiberado() && donoDoRegistro();
      allow create: if acessoLiberado() && metaPesoValida();
      allow update: if acessoLiberado() && donoDoRegistro() && metaPesoValida();
    }

    // Metas de progressão. Semana e mês são recorrentes (valem de `inicio` até `ate`, ou até o usuário trocar); ano vale um ano.
    // O dono cria, lê, altera a vigência e apaga; o conteúdo é validado aqui.
    function metaProgressaoValida() {
      let m = request.resource.data;
      return m.keys().hasOnly(['userId', 'periodo', 'inicio', 'ate', 'tipo', 'valorAlvo', 'esportes', 'criadoEm'])
        && m.keys().hasAll(['userId', 'periodo', 'inicio', 'tipo', 'valorAlvo', 'esportes'])
        && m.userId == request.auth.uid
        && m.periodo in ['ano', 'mes', 'semana']
        && m.inicio is string && m.inicio.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('ate' in m) || m.ate == null || (m.ate is string && m.ate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && m.tipo in ['distancia', 'tempo', 'elevacao', 'condicionamento']
        && m.valorAlvo is number && m.valorAlvo > 0 && m.valorAlvo <= 10000000
        && m.esportes is list && m.esportes.size() <= 3
        && m.esportes.hasOnly(['ciclismo', 'corrida', 'outro'])
        && (!('criadoEm' in m) || m.criadoEm is timestamp);
    }

    match /metasProgressao/{id} {
      allow read, delete: if acessoLiberado() && donoDoRegistro();
      allow create: if acessoLiberado() && metaProgressaoValida();
      allow update: if acessoLiberado() && donoDoRegistro() && metaProgressaoValida();
    }

    // Conquistas (badges de objetivos atingidos): o dono lê; só o servidor concede e atualiza (Admin SDK).
    // Central de notificações: o servidor cria e resolve; o dono só lê. "Marcar como lida" passa por callable
    // (marcarNotificacoesComoLidas), para o cliente nunca alterar o conteúdo de uma notificação.
    match /notificacoes/{id} {
      allow read: if acessoLiberado() && donoDoRegistro();
      allow write: if false;
    }

    match /conquistas/{id} {
      allow read: if acessoLiberado() && donoDoRegistro();
      allow write: if false;
    }

    // Leitura pelo dono; escrita somente via callable/trigger (Admin SDK).
    match /atividades/{id} {
      allow read: if acessoLiberado() && donoDoRegistro();
      allow write: if false;

      match /series/{serie} {
        allow read: if acessoLiberado()
          && get(/databases/$(database)/documents/atividades/$(id)).data.userId == request.auth.uid;
        allow write: if false;
      }
    }

    // Trajetos de treino (nomes que o usuário cria para comparar esforços): o dono lê; só a callable salvarAtividade grava.
    match /trajetos/{id} {
      allow read: if acessoLiberado() && donoDoRegistro();
      allow write: if false;
    }

    match /estresseDiario/{id} {
      allow read: if acessoLiberado() && donoDoRegistro();
      allow write: if false;
    }

    // Resumo de calibração da estimativa de HRSS (mediana do HRSS/h por esporte e zona): o servidor grava, o dono lê.
    match /calibracoes/{id} {
      allow read: if acessoLiberado() && donoDoRegistro();
      allow write: if false;
    }

    // Preferências do usuário, um documento por usuário (id = uid): usar ou não a calibração nas estimativas e o nível dos
    // treinos intervalados.
    match /preferencias/{uid} {
      allow read: if acessoLiberado() && request.auth.uid == uid;
      allow create, update: if acessoLiberado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['userId', 'calibracaoAtiva', 'nivelTreinos', 'diasTreino', 'diaLongao', 'horasSemana', 'esportePrincipal', 'onboarding', 'usoGarmin', 'notificacoes', 'planoIaAutomatico'])
        && request.resource.data.keys().hasAll(['userId'])
        && request.resource.data.userId == request.auth.uid
        && (!('calibracaoAtiva' in request.resource.data) || request.resource.data.calibracaoAtiva is bool)
        && (!('nivelTreinos' in request.resource.data) || request.resource.data.nivelTreinos in ['iniciante', 'intermediario', 'avancado'])
        && (!('diasTreino' in request.resource.data) || (request.resource.data.diasTreino is list
          && request.resource.data.diasTreino.size() >= 1 && request.resource.data.diasTreino.size() <= 7
          && request.resource.data.diasTreino.hasOnly([0, 1, 2, 3, 4, 5, 6])))
        && (!('diaLongao' in request.resource.data) || request.resource.data.diaLongao == null
          || (request.resource.data.diaLongao is int && request.resource.data.diaLongao >= 0 && request.resource.data.diaLongao <= 6))
        && (!('horasSemana' in request.resource.data) || (request.resource.data.horasSemana is number
          && request.resource.data.horasSemana >= 1 && request.resource.data.horasSemana <= 25))
        && (!('esportePrincipal' in request.resource.data) || request.resource.data.esportePrincipal in ['ciclismo', 'corrida', 'ambos'])
        && (!('onboarding' in request.resource.data) || request.resource.data.onboarding in ['concluido', 'pulado'])
        && (!('usoGarmin' in request.resource.data) || request.resource.data.usoGarmin in ['sim', 'nao', 'depois'])
        && (!('planoIaAutomatico' in request.resource.data) || request.resource.data.planoIaAutomatico is bool)
        && (!('notificacoes' in request.resource.data) || preferenciasNotificacaoValidas(request.resource.data.notificacoes));
      allow delete: if false;
    }

    // Última semana montada pela IA na rotina de domingo (um documento por usuário, id = uid): resumo, treinos e o que foi
    // considerado. Só o servidor grava; o dono lê para mostrar o aviso na tela de Treinos.
    match /semanaIa/{uid} {
      allow read: if acessoLiberado() && request.auth.uid == uid;
      allow write: if false;
    }

    match /iaRascunhos/{id} {
      allow read: if acessoLiberado() && donoDoRegistro();
      allow write: if false;
    }

    // Configurações do sistema, definidas pelo administrador (o servidor lê com o Admin SDK).
    // configuracoes/ia: limite diário de sugestões de IA por usuário.
    match /configuracoes/ia {
      allow read: if ehAdmin();
      allow create, update: if ehAdmin()
        && request.resource.data.keys().hasOnly(['chamadasPorDia', 'semLimite', 'atualizadoEm'])
        && request.resource.data.keys().hasAll(['chamadasPorDia', 'semLimite'])
        && request.resource.data.chamadasPorDia is int && request.resource.data.chamadasPorDia >= 1 && request.resource.data.chamadasPorDia <= 500
        && request.resource.data.semLimite is bool
        && (!('atualizadoEm' in request.resource.data) || request.resource.data.atualizadoEm is timestamp);
      allow delete: if false;
    }

    // iaUso e vinculosTreinador: sem acesso direto (somente Admin SDK).
    // users/{uid}/segredos/garmin e /segredos/intervals (chaves pessoais, cifradas) e users/{uid}/intervalsEnvio (registro dos
    // treinos enviados ao intervals.icu) e intervalsConexoes/{uid} (estado da conexão e da sincronização automática de
    // atividades do intervals.icu): sem regra, logo negados ao cliente. A regra de
    // /users/{uid} não vale para subcoleções. Não crie um `match` curinga em users/{uid}/{document=**}.
  }
}

# Copie para .env.homolog e preencha com os valores do projeto Firebase de HOMOLOG.
# Apenas configuração pública do cliente (VITE_*). Nunca coloque segredos aqui.
VITE_FIREBASE_API_KEY=TROCAR
VITE_FIREBASE_AUTH_DOMAIN=TROCAR-no-strova-homolog.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=TROCAR-no-strova-homolog
VITE_FIREBASE_STORAGE_BUCKET=TROCAR-no-strova-homolog.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=TROCAR
VITE_FIREBASE_APP_ID=TROCAR

# Opcional: ID do cliente do app no Strava ("Meu aplicativo API" no site do Strava). É público (vai na URL de autorização);
# o segredo do cliente NÃO entra aqui: fica no Secret Manager (STRAVA_CLIENT_SECRET). Sem ele, o botão "Conectar ao Strava" avisa que falta configurar.
VITE_STRAVA_CLIENT_ID=

# Opcional: token PUBLICO do Mapbox (mapa do detalhe da atividade). Sem ele, usa o OpenStreetMap.
VITE_MAPBOX_TOKEN=

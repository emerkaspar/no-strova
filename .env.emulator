# Desenvolvimento local contra o Firebase Emulator Suite (projeto "demo-", sem credenciais reais).
# Usado por `npm run dev:emulator` (vite --mode emulator).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-no-strova.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-no-strova
VITE_FIREBASE_STORAGE_BUCKET=demo-no-strova.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_EMULATORS=true
